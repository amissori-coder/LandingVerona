{
  "name": "ngb-diretta-prove",
  "version": "1.0.0",
  "private": true,
  "description": "Prove della Diretta degli eventi: regole Firestore, doppioni, accessi, Playwright e carico, contro gli emulatori Firebase",
  "engines": { "node": ">=20" },
